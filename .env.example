# Copy to a protected environment file; never commit real values.
IMBRIDGE_LISTEN=127.0.0.1:8787
IMBRIDGE_DATA_DIR=/var/lib/im-bridge
IMBRIDGE_MASTER_KEY_PATH=/etc/im-bridge/master.key
IMBRIDGE_SESSION_TTL_HOURS=12
IMBRIDGE_COOKIE_SECURE=true
IMBRIDGE_ST_BASE_URL=http://127.0.0.1:18000
IMBRIDGE_ST_HANDLE=default-user
IMBRIDGE_ST_MODE=read_only
IMBRIDGE_ST_CONNECTOR_HMAC_KEY=
# IMBRIDGE_TELEGRAM_API_BASE=https://api.telegram.org
